import { NextRequest, NextResponse } from 'next/server';
import { verifyUserRole } from '@/lib/api-auth';
import { {{camelCase name}}CreateSchema } from '@/server/schemas/{{kebabCase name}}-schema';
import * as service from '@/server/services/{{kebabCase name}}-service';

export async function GET(req: NextRequest) {
  try {
    // 1. Authenticate user
    const authResult = await verifyUserRole(['OWNER', 'MANAGER', 'STAFF']);
    if (!authResult.success) {
      return authResult.errorResponse;
    }

    // 2. Business operation
    const items = await service.listAll{{pascalCase name}}s();
    return NextResponse.json({ success: true, data: items });
  } catch (error) {
    return NextResponse.json(
      {
        success: false,
        error: {
          code: 'INTERNAL_SERVER_ERROR',
          message: (error as Error).message,
        },
      },
      { status: 500 }
    );
  }
}

export async function POST(req: NextRequest) {
  try {
    // 1. Authenticate user
    const authResult = await verifyUserRole(['OWNER', 'MANAGER']);
    if (!authResult.success) {
      return authResult.errorResponse;
    }

    // 2. Parse request JSON
    let body;
    try {
      body = await req.json();
    } catch {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'BAD_REQUEST',
            message: 'Invalid request body.',
          },
        },
        { status: 400 }
      );
    }

    // 3. Validate request schema
    const validationResult = {{camelCase name}}CreateSchema.safeParse(body);
    if (!validationResult.success) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'BAD_REQUEST',
            message: validationResult.error.issues[0]?.message || 'Validation failed.',
          },
        },
        { status: 400 }
      );
    }

    // 4. Invoke service
    const result = await service.createNew{{pascalCase name}}(validationResult.data);
    if (!result.success) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'INTERNAL_SERVER_ERROR',
            message: result.error || 'Failed to create resource.',
          },
        },
        { status: 500 }
      );
    }

    return NextResponse.json({ success: true, data: result.data }, { status: 201 });
  } catch (error) {
    return NextResponse.json(
      {
        success: false,
        error: {
          code: 'INTERNAL_SERVER_ERROR',
          message: (error as Error).message,
        },
      },
      { status: 500 }
    );
  }
}
