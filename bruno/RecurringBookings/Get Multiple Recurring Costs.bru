meta {
  name: Get Multiple Recurring Costs
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/bookings/recurring/costs?ruleIds={{createdRecurringRuleId}}
  body: none
  auth: none
}

headers {
  Cookie: {{supabaseCookieName}}={{supabaseCookie}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data[0].ruleId: eq {{createdRecurringRuleId}}
}
