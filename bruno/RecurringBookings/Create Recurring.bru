meta {
  name: Create Recurring
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/bookings/recurring
  body: json
  auth: none
}

headers {
  Cookie: {{supabaseCookieName}}={{supabaseCookie}}
}

body:json {
  {
    "courtId": "{{testCourtId}}",
    "customerId": "{{testCustomerId}}",
    "startTime": "08:00",
    "endTime": "10:00",
    "startDate": "2026-08-01",
    "endDate": "2026-08-15",
    "daysOfWeek": [1, 3, 5]
  }
}

script:post-response {
  const data = res.getBody();
  if (res.status === 200 && data && data.success && data.data && data.data.ruleId) {
    bru.setVar('createdRecurringRuleId', data.data.ruleId);
  }
}
